{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m src.agent:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "ask": [
      "Edit(./data/**)",
      "Edit(./config/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push:*)",
      "WebFetch"
    ]
  },
  "enableAllProjectMcpServers": false
}
