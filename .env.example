# Copy this file to .env and fill in values ONLY if you extend the demo with a real LLM.
# The Python demonstration does not read this file and needs no keys.
# Never commit .env. It is listed in .gitignore.

# Optional: LLM provider keys (placeholders - not real)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Optional: demo settings
HOSPITAL_NAME="Maple Grove General Hospital (fictional)"
LOG_LEVEL=WARNING
